NODE_ENV=development
DATABASE_URL=postgresql://obras:development@localhost:5432/obras
REDIS_URL=redis://localhost:6379
# Generate a local value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
PORT=3001
# Development only; seed refuses production. See README.
DEMO_PASSWORD=Demo-Obras!2026

# API and worker must share this directory (default: work/budget-storage).
# BUDGET_STORAGE_PATH=/absolute/path/to/budget-storage
WORKER_HEALTH_PORT=3003
# Private M3 uploads; persist this directory. Compose configures a named volume.
# DOCUMENT_STORAGE_PATH=/absolute/path/to/document-storage

# Segregation: creators cannot approve their own expenses/amendments (including ADMIN).
PREVENT_SELF_APPROVAL=true

# M7: stream writes private .eml files for local validation; SMTP is opt-in.
MAIL_TRANSPORT=stream
MAIL_FROM=obras@example.test
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_OUTBOX_PATH=/absolute/private/mail-outbox
