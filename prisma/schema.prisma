  planId    String           @map("plan_id") @db.Uuid
  featureId String           @map("feature_id") @db.Uuid
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  feature   Feature          @relation(fields: [featureId], references: [id])
  enabled   Boolean          @default(false)

  @@id([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  billingCycle           BillingCycle       @default(MANUAL) @map("billing_cycle")
  trialStart             DateTime?          @map("trial_start") @db.Timestamptz(6)
  trialEnd               DateTime?          @map("trial_end") @db.Timestamptz(6)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  suspendedAt            DateTime?          @map("suspended_at") @db.Timestamptz(6)
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")
  version                Int                @default(1)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([status, trialEnd])
  @@map("subscriptions")
}

model TenantUsage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  usageKey     String   @map("usage_key")
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  usedQuantity BigInt   @map("used_quantity")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, usageKey, periodStart])
  @@map("tenant_usage")
}

model TenantSetting {
  tenantId              String    @id @map("tenant_id") @db.Uuid
  defaultCurrency       String    @default("MZN") @map("default_currency")
  timezone              String    @default("Africa/Maputo")
  dateFormat            String    @default("dd/MM/yyyy") @map("date_format")
  companyLogoDocumentId String?   @map("company_logo_document_id") @db.Uuid
  supportEmail          String?   @map("support_email")
  brandingPrimary       String?   @map("branding_primary")
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(6)
  exportAllowed         Boolean   @default(true) @map("export_allowed")
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_settings")
}

model TenantStatusEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  reason     String
  changedBy  String   @map("changed_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("tenant_status_events")
}

model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

model SupportSession {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  reason         String
  authorizedBy   String    @map("authorized_by") @db.Uuid
  status         String    @default("ACTIVE")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)

  @@index([platformUserId, status, expiresAt])
  @@map("support_sessions")
}

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  enabled           Boolean  @default(false)
  description       String
  rolloutPercentage Int?     @map("rollout_percentage")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model TenantFeatureOverride {
  tenantId      String  @map("tenant_id") @db.Uuid
  featureFlagId String  @map("feature_flag_id") @db.Uuid
  enabled       Boolean

  @@id([tenantId, featureFlagId])
  @@map("tenant_feature_overrides")
}

model BillingInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  invoiceNumber     String    @unique @map("invoice_number")
  periodStart       DateTime  @map("period_start") @db.Date
  periodEnd         DateTime  @map("period_end") @db.Date
  subtotal          Decimal   @db.Decimal(18, 2)
  taxAmount         Decimal   @map("tax_amount") @db.Decimal(18, 2)
  totalAmount       Decimal   @map("total_amount") @db.Decimal(18, 2)
  currency          String    @db.VarChar(3)
  status            String    @default("DRAFT")
  dueDate           DateTime? @map("due_date") @db.Date
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  externalInvoiceId String?   @map("external_invoice_id")
  idempotencyKey    String    @map("idempotency_key")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("billing_invoices")
}

model DataExportJob {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  status      String    @default("QUEUED")
  requestedBy String    @map("requested_by") @db.Uuid
  objectKey   String?   @map("object_key")
  errorCode   String?   @map("error_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("data_export_jobs")
}

model UserLegalAcceptance {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress    String?  @map("ip_address")

  @@unique([userId, tenantId, documentType, version])
  @@map("user_legal_acceptances")
}
